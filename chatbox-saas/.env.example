# Copie para .env e ajuste valores reais (nunca commite .env).

APP_NAME="Chatbox SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# URL pública da aplicação (widget, redirects, links). Em XAMPP/vhost use o host real, ex.: http://chatbox.local
# APP_URL=https://seudominio.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# CORS para rotas api/* — em produção liste origens separadas por vírgula (ex: https://cliente.com,https://www.cliente.com):
# Em local o default é *; em production o default é vazio até definir esta variável.
CORS_ALLOWED_ORIGINS=https://seudominio.com

# Go-live / segurança (defaults: false em APP_ENV=production)
# FILAMENT_REGISTRATION_ENABLED=true
# DEMO_ROUTES_ENABLED=true
# BILLING_SIMULATION_ENABLED=true
# PAYMENT_DRIVER=none
# PAYMENT_DRIVER=stripe
# PAYMENT_DRIVER=mercadopago
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=brl
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=...
# MERCADOPAGO_CURRENCY=BRL
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatbox_saas
DB_USERNAME=root
DB_PASSWORD=

# XAMPP Windows — caminho do mysqldump para backup Spatie (ajuste se instalacao diferente)
# MYSQL_DUMP_BINARY_PATH=C:/xampp/mysql/bin

# Drivers Recomendados para Produção: redis (requer servidor Redis configurado)
# O uso do driver database não é recomendado para alta concorrência.
# XAMPP local (sem Redis): descomente o bloco abaixo
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=database
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (tempo real — opcional)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# WhatsApp Cloud (integração)
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_OUTBOUND_QUEUE=default

# NexIntelligence — Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CSP — em production unsafe-eval fica desactivado (default seguro)
# CSP_ALLOW_UNSAFE_EVAL=true

# Portal Swagger UI em /api/docs (default off em production)
# API_DOCS_ENABLED=true
# API_DOCS_BASIC_AUTH_USER=docs
# API_DOCS_BASIC_AUTH_PASSWORD=changeme

# SUBSCRIPTION_EXPIRY_WARNING_DAYS=7
# SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# Monitorização (system:health-check, GET /api/v1/health/status)
# HEALTH_CHECK_TOKEN=
# HEALTH_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# HEALTH_ALERT_WEBHOOK_URL=https://seu-monitor/webhook
# HEALTH_QUEUE_PENDING_WARNING=50
# HEALTH_QUEUE_PENDING_CRITICAL=200
# HEALTH_FAILED_JOBS_WARNING=1
# HEALTH_ERROR_LOG_WARNING_24H=10
# HEALTH_BACKUP_MAX_AGE_HOURS=26
# HEALTH_DISK_FREE_MIN_MB=500

# Backup (Spatie) — ficheiros em storage/app/backups; off-site via BACKUP_DISKS=backups,s3
# BACKUP_DISKS=backups
# BACKUP_DISKS=backups,s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
# AWS_BUCKET=chatbox-backups
# BACKUP_ARCHIVE_PASSWORD=
SENTRY_LARAVEL_DSN=
